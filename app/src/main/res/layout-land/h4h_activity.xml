                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/darker_gray"
                android:padding="3sp">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/platform1ID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/oneID"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/platform1Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="3sp"
                        android:text="@string/waiting" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:weightSum="2">


                    <EditText
                        android:id="@+id/platform1Name"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:autofillHints="Name"
                        android:hint="@string/platform_name"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:text="rad_c100" />

                    <Spinner
                        android:id="@+id/platform1Spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:weightSum="5">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/statusConn"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/platform1IP"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:digits="0123456789."
                        android:ems="10"
                        android:hint="@string/ip_address"
                        android:imeOptions="actionDone"
                        android:text="@string/kxm_ip" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text=":"
                        android:textSize="20sp" />

                    <EditText
